/* Paleta de cores do PIO Solver */
:root {
  --color-fold: #E74C3C;
  --color-call: #2ECC71;
  --color-raise: #3498DB;
  --color-bg-dark: #2C3E50;
  --color-bg-light: #ECF0F1;
  --color-text: #2C3E50;
  --color-border: #BDC3C7;
  --color-accent: #F39C12;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: linear-gradient(135deg, #2C3E50 0%, #34495E 100%);
  color: var(--color-text);
  min-height: 100vh;
}

.trainer-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
}

.trainer-header {
  text-align: center;
  color: white;
  margin-bottom: 40px;
  padding: 30px 20px;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 10px;
  border-bottom: 4px solid var(--color-accent);
}

.trainer-header h1 {
  font-size: 2.5em;
  margin-bottom: 10px;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

.trainer-header p {
  font-size: 1.1em;
  opacity: 0.9;
}

.trainer-content {
  display: grid;
  grid-template-columns: 1fr 2fr 1fr;
  gap: 20px;
  margin-bottom: 20px;
}

/* Position Selector */
.position-selector {
  background: white;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.position-selector h3 {
  margin-bottom: 15px;
  color: var(--color-text);
  font-size: 1.1em;
}

.position-buttons {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.position-btn {
  padding: 12px;
  border: 2px solid var(--color-border);
  background: white;
  color: var(--color-text);
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
  transition: all 0.3s ease;
  font-size: 1em;
}

.position-btn:hover {
  background: var(--color-bg-light);
  border-color: var(--color-accent);
}

.position-btn.active {
  background: var(--color-accent);
  color: white;
  border-color: var(--color-accent);
  box-shadow: 0 4px 8px rgba(243, 156, 18, 0.3);
}

/* Main Trainer Area */
.trainer-main {
  background: white;
  padding: 30px;
  border-radius: 10px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hand-display {
  text-align: center;
  margin-bottom: 30px;
}

.hand-display h2 {
  color: var(--color-text);
  margin-bottom: 15px;
  font-size: 1.3em;
}

.hand-card {
  background: linear-gradient(135deg, #34495E 0%, #2C3E50 100%);
  color: white;
  padding: 40px;
  border-radius: 15px;
  border: 3px solid var(--color-accent);
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
  min-width: 150px;
}

.hand-text {
  font-size: 3em;
  font-weight: bold;
  letter-spacing: 5px;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
}

.action-buttons {
  width: 100%;
  margin-bottom: 30px;
}

.action-buttons h3 {
  text-align: center;
  margin-bottom: 20px;
  color: var(--color-text);
  font-size: 1.2em;
}

.buttons-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.action-btn {
  padding: 20px;
  font-size: 1.1em;
  font-weight: bold;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.3s ease;
  color: white;
  text-transform: uppercase;
  letter-spacing: 1px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
}

.action-btn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
}

.action-btn.action-fold {
  background: var(--color-fold);
}

.action-btn.action-fold:hover:not(:disabled) {
  background: #C0392B;
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(231, 76, 60, 0.3);
}

.action-btn.action-call {
  background: var(--color-call);
}

.action-btn.action-call:hover:not(:disabled) {
  background: #27AE60;
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(46, 204, 113, 0.3);
}

.action-btn.action-raise {
  background: var(--color-raise);
}

.action-btn.action-raise:hover:not(:disabled) {
  background: #2980B9;
  transform: translateY(-2px);
  box-shadow: 0 6px 12px rgba(52, 152, 219, 0.3);
}

.action-btn.selected {
  transform: scale(1.05);
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
}

/* Feedback */
.feedback {
  width: 100%;
  padding: 20px;
  border-radius: 10px;
  margin-top: 20px;
  text-align: center;
  animation: slideIn 0.3s ease;
}

.feedback.correct {
  background: rgba(46, 204, 113, 0.1);
  border: 2px solid var(--color-call);
  color: #27AE60;
}

.feedback.incorrect {
  background: rgba(231, 76, 60, 0.1);
  border: 2px solid var(--color-fold);
  color: #C0392B;
}

.feedback h4 {
  font-size: 1.3em;
  margin-bottom: 15px;
}

.feedback p {
  margin: 8px 0;
  font-size: 1em;
}

.next-btn {
  margin-top: 20px;
  padding: 12px 30px;
  background: var(--color-accent);
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 1em;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.3s ease;
}

.next-btn:hover {
  background: #E67E22;
  transform: translateY(-2px);
  box-shadow: 0 4px 8px rgba(243, 156, 18, 0.3);
}

/* Stats Panel */
.stats-panel {
  background: white;
  padding: 20px;
  border-radius: 10px;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

.stats-panel h3 {
  margin-bottom: 20px;
  color: var(--color-text);
  text-align: center;
  font-size: 1.1em;
}

.stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-text);
}

.stat-item:last-of-type {
  border-bottom: none;
}

.stat-item span {
  font-weight: 500;
}

.stat-item strong {
  font-size: 1.2em;
  color: var(--color-accent);
}

.progress-bar {
  width: 100%;
  height: 20px;
  background: var(--color-bg-light);
  border-radius: 10px;
  overflow: hidden;
  margin-top: 15px;
  border: 2px solid var(--color-border);
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-call) 0%, var(--color-accent) 100%);
  transition: width 0.3s ease;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Responsivo */
@media (max-width: 1024px) {
  .trainer-content {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .trainer-header h1 {
    font-size: 1.8em;
  }

  .hand-text {
    font-size: 2em;
  }

  .buttons-grid {
    grid-template-columns: 1fr;
  }
}
